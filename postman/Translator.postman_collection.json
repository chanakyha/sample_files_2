    {
      "name": "4. Data-driven (Collection Runner + CSV)",
      "description": "Run this folder in the Collection Runner with postman/translation-data.csv. Columns: text, tl, expectedLang, expectedContains. Leave expectedLang/expectedContains empty to skip that check. The body is built in the pre-request script so texts with quotes stay valid JSON.",
      "item": [
        {
          "name": "Translate {{text}} -> {{tl}}",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(JSON.stringify({",
                  "    q: pm.iterationData.get('text'),",
                  "    source: 'auto',",
                  "    target: pm.iterationData.get('tl'),",
                  "    format: 'text'",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectedLang = pm.iterationData.get('expectedLang');",
                  "const expectedContains = pm.iterationData.get('expectedContains');",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Translation is not empty', () => pm.expect(json.translatedText).to.not.be.empty);",
                  "if (expectedLang) {",
                  "    pm.test(`Detected ${expectedLang}`, () => pm.expect(json.detectedLanguage.language).to.eql(expectedLang));",
                  "}",
                  "if (expectedContains) {",
                  "    pm.test(`Contains \"${expectedContains}\"`, () => pm.expect(json.translatedText.toLowerCase()).to.include(expectedContains.toLowerCase()));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/translate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "translate"
              ]
            }
          }
        }
      ]
    },
